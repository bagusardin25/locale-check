+# Scripts written right to left. The UI languages Open Library ships include ar, fa and he.
+RTL_LANGS = frozenset({"ar", "fa", "he", "ur"})
+
+
 class LayoutContext:
@@
     @property
     def active_ui_lang(self) -> dict[str, str]:
@@
         return {"code": "en", "localized": "English", "native": "English"}
+
+    @property
+    def dir(self) -> str:
+        """Text direction for <html dir>: "rtl" for right-to-left UI languages."""
+        return "rtl" if self.lang.split("-")[0].lower() in RTL_LANGS else "ltr"

